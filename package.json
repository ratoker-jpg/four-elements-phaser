{
  "name": "four-elements-phaser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "generate:building-meta": "node tools/generate_building_meta.mjs",
    "test:generator": "python3 tools/test_generate_building_meta.py -v",
    "validate:asset-manifest": "node tools/validate_manifest.mjs art/generated/manifest.sample.json",
    "test:asset-manifest": "node tools/test_validate_manifest.mjs"
  },
  "dependencies": {
    "phaser": "4.1.0"
  },
  "devDependencies": {
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.7"
  }
}
