{
  "name": "four-elements-phaser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root .",
    "test:watch": "vitest --root .",
    "preview": "vite preview",
    "generate:building-meta": "node tools/generate_building_meta.mjs",
    "generate:modular-meta": "node tools/generate_modular_vehicle_metadata.mjs",
    "test:generator": "python3 tools/test_generate_building_meta.py -v",
    "validate:asset-manifest": "node tools/validate_manifest.mjs art/generated/manifest.sample.json",
    "test:asset-manifest": "node tools/test_validate_manifest.mjs",
    "process:art-assets": "node tools/process_art_assets.mjs",
    "test:process-art-assets": "node tools/test_process_art_assets.mjs",
    "test:art-sample-viewer": "node tools/test_art_sample_viewer.mjs",
    "view:art-sample": "echo 'Open http://localhost:5173/task/art-sample/index.html after running npm run dev'",
    "qa:smoke": "node tools/qa_smoke.mjs"
  },
  "dependencies": {
    "phaser": "4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.7"
  }
}
